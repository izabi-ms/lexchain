# Runtime
APP_ENV=development
# For local development the backend defaults to a SQLite database.
# For PostgreSQL, set e.g. postgresql+psycopg2://USER:PASSWORD@localhost:5432/lexchain
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# AI provider: NVIDIA NIM is the only enabled provider in this phase.
AI_PROVIDER=nvidia_nim
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=
NVIDIA_NIM_TIMEOUT_SECONDS=180

# Future optional local model provider. Ollama remains disabled unless deliberately implemented/enabled later.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# Blockchain (optional during local development; required to test notarization)
INFURA_URL=
CONTRACT_ADDRESS=
ACCOUNT_ADDRESS=
PRIVATE_KEY=

# IPFS cloud storage (Pinata). Documents are encrypted before upload.
IPFS_PROVIDER=pinata
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IPFS_ENCRYPTION_KEY=
